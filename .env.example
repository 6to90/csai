# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_URL=http://localhost:3000

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never commit real values
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64:  openssl rand -base64 32   (kept OUTSIDE the database)
SECRETS_MASTER_KEY=
# During master-key rotation only: the old key (then run rewrapAll and remove this)
SECRETS_MASTER_KEY_PREVIOUS=
CRON_SECRET=
RATE_LIMIT_SALT=
# Number of trusted reverse proxies in front of the app (X-Forwarded-For is read from the right). 0 = ignore the header.
TRUSTED_PROXY_HOPS=1

# CAPTCHA (Cloudflare Turnstile, free). Public site key for the browser widget; the SECRET goes only to Supabase Auth (dashboard / config env), never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SIGNUP_MODE=invite_only   # 'open' only together with supabase enable_signup=true

# Invitation e-mail (Phase 3A). Unset = no mail: the invite link is returned once in the API response instead.
# MAIL_TRANSPORT=mailpit (local mailbox via MAIL_HTTP_URL=http://127.0.0.1:54324) | smtp (MAIL_SMTP_URL=smtp://host:25 | smtps://user:pass@host:465 | smtp+starttls://user:pass@host:587)
MAIL_TRANSPORT=
MAIL_HTTP_URL=
MAIL_SMTP_URL=
MAIL_FROM=

# SECURITY: leave UNSET. Allows tenant-supplied SMTP URLs to target private/loopback hosts (SSRF risk on multi-tenant deployments). Tests/self-hosted single-tenant only.
# SMTP_ALLOW_PRIVATE_HOSTS=1
